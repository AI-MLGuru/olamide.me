---
import { profile } from '~/data/profile';
import { isActivePath, withBase } from '~/lib/paths';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/projects/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={withBase('/')} aria-label={`${profile.name}, home`}>
      <span class="brand__mark" aria-hidden="true">
        OF
      </span>
      <span class="brand__name">{profile.name}</span>
    </a>

    <nav aria-label="Main">
      <ul class="nav">
        {nav.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              aria-current={isActivePath(current, item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-right: auto;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: background-color 200ms var(--ease-out);
  }

  .brand:hover .brand__mark {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .nav {
    display: flex;
    gap: clamp(0.25rem, 1.5vw, 1rem);
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: block;
    padding: 0.45rem 0.6rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 160ms var(--ease-out);
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--ink);
  }

  .nav a[aria-current='page'] {
    background: var(--bg-sunken);
  }

  @media (max-width: 34rem) {
    .brand__name {
      display: none;
    }

    .site-header__inner {
      gap: var(--space-xs);
    }
  }
</style>
